{
  "name": "zai-pi-extension",
  "version": "2.1.0",
  "description": "Z AI integration for pi-agent - Web Search, Web Reader, and GitHub Reader",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun run test-integration.ts",
    "probe": "bun run scripts/probe.ts",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^0.10.0",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}